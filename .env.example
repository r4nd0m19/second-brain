# second-brain 环境配置 —— 复制为 .env 并填入真实值（.env 已被 git 忽略）

# ── 对话模型（默认 DeepSeek，成本优先）──
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ── Embedding（默认硅基流动 bge-m3，免费）──
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ── 数据库 ──
DATABASE_URL=postgresql+asyncpg://secondbrain:secondbrain@localhost:5433/secondbrain

# ── 单用户账号（T008 认证使用）──
ADMIN_USERNAME=me
ADMIN_PASSWORD=change-me-please

# ── 会话签名密钥（随机长字符串）──
SECRET_KEY=change-me-random-string

# ── 存储与限额 ──
STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=200

# ── MCP（可选）──
# DNS-rebinding 白名单追加（逗号分隔、含端口的 host）；默认仅本机（localhost/127.0.0.1）
#MCP_ALLOWED_HOSTS=192.168.1.5:8000

# ── 调试（可选）──
# API 文档端点（/docs /redoc /openapi.json）：默认关闭（未认证信息暴露面），本地调试可开
#DOCS_ENABLED=true
